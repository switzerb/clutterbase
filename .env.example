VITE_SUPABASE_URL=http://127.0.0.1:54321
# Obtain the local publishable key with `vp exec supabase status`.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional when exactly one membership exists; set to the configured archive UUID at deployment.
VITE_ARCHIVE_ID=
# Set false for a Google-only hosted pilot while custom SMTP is deferred.
VITE_EMAIL_SIGN_IN_ENABLED=true
